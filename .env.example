# ════════════════════════════════════════════════════════════════════════════
# TaskSense Docker Environment Configuration
# ════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────
# Spring Boot Backend Configuration
# ──────────────────────────────────────────────────────────────────────────

# Shared JWT signing secret for backend and AI token validation.
# Use a long random value and never commit real production secrets.
SECURITY_JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:5173

# Email Configuration (Gmail)
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# AWS S3 (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=your-s3-bucket
AWS_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────
# AI Service Configuration
# ──────────────────────────────────────────────────────────────────────────

# Explicit browser origins allowed to call the AI API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tasksense.app,https://tasksense.io.vn

# LLM Provider: openai, anthropic, etc.
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Configuration (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Qdrant Vector Database
QDRANT_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Frontend Configuration
# ──────────────────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_API_BASE_URL=http://localhost:8080/ai

# ──────────────────────────────────────────────────────────────────────────
# Database Configuration (usually defaults)
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskdb

# Redis (usually defaults)
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch (usually defaults)
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
