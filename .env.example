# TaskSense deployment environment template
#
# Copy this file to `.env` on the deployment host:
#   cp .env.example .env
#
# Never commit real production secrets.

# ---------------------------------------------------------------------------
# Required shared security
# ---------------------------------------------------------------------------

# Shared by Spring API and AI service. Use a long random secret in production.
SECURITY_JWT_SECRET=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=postgres
# Keep `postgres` when using the current infra/docker/compose.yaml directly.
# That compose file still hardcodes postgres credentials in Flyway, seed,
# and Spring datasource. Use a secure compose override before changing this
# in production.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskdb

# ---------------------------------------------------------------------------
# Spring API: OAuth, email, object storage
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost

EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

AWS_REGION=us-east-1
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=tasksense
AWS_ENDPOINT=your-s3-endpoint-host

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------

# CORS origins allowed to call the AI API. Use the public frontend origin in prod.
CORS_ORIGINS=http://localhost,http://localhost:5173

# Supported by code: openai, gemini, openrouter, siliconflow.
# infra/docker/compose.yaml defaults this to openai.
LLM_PROVIDER=openai

# Embedding provider used by AI sync/retrieval.
# infra/docker/compose.yaml defaults this to openrouter.
LLM_EMBEDDING_PROVIDER=openrouter

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
SILICONFLOW_API_KEY=

QDRANT_API_KEY=
ENABLE_SYNC=True

# ---------------------------------------------------------------------------
# Frontend build-time variables
# ---------------------------------------------------------------------------

# These variables are build-time inputs for Vite. If any value changes,
# rebuild the frontend image.
#
# The current infra/docker/compose.yaml has localhost URL build args.
# CI passes these values through docker compose build --build-arg.
# For manual production builds, use the same build args or a compose override.
VITE_API_BASE_URL=http://localhost/api/core/v1
VITE_API_AGENT_BASE_URL=http://localhost/api/chat/v1
VITE_WS_URL=ws://localhost/api/core/v1/ws
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ---------------------------------------------------------------------------
# Image registry override
# ---------------------------------------------------------------------------

# Required only when using:
#   docker compose -f infra/docker/compose.yaml -f infra/docker/compose.build.yaml ...
#
# Example:
#   IMAGE_PREFIX=ghcr.io/acme/tasksense
#   IMAGE_TAG=2026-06-05-abcdef
IMAGE_PREFIX=
IMAGE_TAG=latest
